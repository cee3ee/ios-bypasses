[Unit]
Description=Automatic iOS Location Spoofer
After=tunneld.service
Requires=tunneld.service

[Service]
Type=simple
Environment=HOME=/root
EnvironmentFile=-/etc/default/auto-spoof
ExecStart=/opt/ios-spoofer/bin/python -u /usr/local/bin/auto_spoof.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
