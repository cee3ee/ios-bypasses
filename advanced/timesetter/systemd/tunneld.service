[Unit]
Description=pymobiledevice3 RemoteXPC Wi-Fi Tunnel Daemon
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/root
ExecStartPre=/bin/bash -c 'until ip -4 addr show wlan0 | grep -q "inet "; do sleep 1; done; sleep 5'
ExecStart=/opt/ios-spoofer/bin/python -m pymobiledevice3 remote tunneld --no-usb --no-usbmux
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
